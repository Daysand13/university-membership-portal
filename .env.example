# ==========================================================================
# Copy this file to .env and fill in real values. Never commit .env.
# ==========================================================================

# --- Database (PostgreSQL) -------------------------------------------------
# Any standard Postgres connection string works — Neon, Supabase, Railway,
# Render, or a self-hosted instance all have generous free tiers.
DATABASE_URL="postgresql://user:password@localhost:5432/university_portal"

# --- Auth --------------------------------------------------------------
# A long, random secret used to sign session cookies (admin + member).
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of the deployed app (no trailing slash). Used to build
# links in emails and the sitemap.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Cloudflare R2 (object storage) ----------------------------------------
# Create a bucket at dash.cloudflare.com -> R2, then an API token scoped to
# "Object Read & Write" on that bucket only. See README.md for full steps.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# S3-compatible endpoint, usually https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=""
# Public base URL for reading uploaded files back (R2 public bucket domain
# or your own custom domain pointed at the bucket). No trailing slash.
R2_PUBLIC_URL=""

# --- Email (Resend) ----------------------------------------------------
# Leave blank during local development — emails are logged to the console
# instead of sent, so every flow is still fully testable without an account.
RESEND_API_KEY=""
EMAIL_FROM="Acme University SA <no-reply@example.edu.gh>"

# Paystack — powers the membership dues payment flow (member dashboard ->
# Pay with Paystack). Leave blank during local development; the dashboard
# will show "online payment isn't set up yet" instead of a broken button.
# Use the SECRET key (not the public key — this project never sends the
# browser to Paystack's JS SDK, only redirects to a URL Paystack returns).
# Also paste this same secret key into Paystack's dashboard webhook signing
# check by pointing a webhook at /api/webhooks/paystack — Paystack signs
# webhook bodies with this same key.
PAYSTACK_SECRET_KEY=""
