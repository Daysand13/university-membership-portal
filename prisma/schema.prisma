generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==================================================================
// ENUMS
// ==================================================================

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MEMBERSHIP_OFFICER
  LIBRARIAN
  ELECTION_OFFICER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Where an election stands on the day itself, which is a different
/// question from whether its page is published.
enum ElectionPhase {
  SCHEDULED
  OPEN
  POSTPONED
  CLOSED
}

enum CandidateStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum MemberStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MessageStatus {
  NEW
  READ
  ARCHIVED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  TIKTOK
  YOUTUBE
  LINKEDIN
  WHATSAPP
  TELEGRAM
  CUSTOM
}

enum NotificationType {
  NEW_APPLICATION
  NEW_MESSAGE
  SYSTEM
}

enum MediaCategory {
  HERO
  NEWS
  EVENT
  ELECTION
  PROFILE
  LIBRARY_THUMBNAIL
  DONATION
  LOGO
  OTHER
}

enum MembershipType {
  REGULAR
  DISTANCE
  SANDWICH
}

enum TeamMemberType {
  LEADERSHIP
  PATRON
}

enum ApplicationTrack {
  UNDERGRADUATE
  POSTGRADUATE
}

// ==================================================================
// ADMIN & AUTH
// ==================================================================

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)

  /// Per-account overrides on top of what the base role allows, as
  /// { "module.capability": true | false }. Absent keys follow the role,
  /// so an account with no overrides behaves exactly as it always has.
  /// See lib/auth/capabilities.ts for the catalogue of keys.
  permissionMask Json?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  newsArticles         News[]
  events               Event[]
  documents            Document[]
  elections            Election[]
  reviewedApplications MembershipApplication[] @relation("ApplicationReviewer")
  reviewedPatrons      PatronProfile[]         @relation("PatronReviewer")
  recordedDonations    Donation[]              @relation("DonationRecorder")
  recordedExpenses     Expense[]               @relation("ExpenseRecorder")
  reviewedBroadcasts   Broadcast[]             @relation("BroadcastReviewer")
  patronMessages       PatronMessage[]         @relation("PatronMessageAuthor")
  advocacyCampaigns    AdvocacyCampaign[]      @relation("CampaignCreator")
  accessibilityIssues  AccessibilityIssue[]    @relation("IssueCreator")
  auditLogs            AuditLog[]
  uploadedMedia        Media[]
  imageDescriptions    ImageDescription[]
  passwordResetTokens  AdminPasswordResetToken[]

  sentBroadcasts        Broadcast[]           @relation("BroadcastAuthor")
  assignedReports       BarrierReport[]       @relation("BarrierReportAssignee")
  reportUpdates         BarrierReportUpdate[] @relation("BarrierReportUpdateAuthor")
  reviewedSupport       SupportRequest[]      @relation("SupportRequestReviewer")
  reviewedOpportunities Opportunity[]         @relation("OpportunityReviewer")
  handledSoftware       SoftwareRequest[]     @relation("SoftwareRequestHandler")
  reviewedCandidacies   ElectionCandidate[]   @relation("CandidateReviewer")
  registeredStations    PollingStation[]      @relation("StationRegistrar")
  recordedDocumentFees  DocumentPurchase[]    @relation("DocumentPurchaseRecorder")

  // Link to the unified identity row. The granular AdminRole above stays
  // the source of truth for what an admin may actually do — the unified
  // model only records THAT they're an admin, never flattening these six
  // distinct permission levels into one.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  @@map("admin_users")
}

model Member {
  id                 String  @id @default(cuid())
  indexNumber        String  @unique
  passwordHash       String
  mustChangePassword Boolean @default(true)

  firstName       String
  middleName      String?
  lastName        String
  dateOfBirth     DateTime?
  gender          Gender?
  profileImageUrl String?
  phone           String
  email           String    @unique

  applicationTrack       ApplicationTrack?
  degreeCategory         String?
  programme              String
  department             String
  academicDepartment     String?
  hallOfAffiliation      String?
  specificSupportNeeds   String[]          @default([])
  level                  String
  campus                 String
  yearOfAdmission        Int
  expectedGraduationYear Int?

  medicalReportUrl String?

  residentialAddress    String?
  region                String?
  emergencyContactName  String?
  emergencyContactPhone String?

  membershipType MembershipType?
  status         MemberStatus    @default(ACTIVE)
  graduatedAt    DateTime?

  applicationId String?                @unique
  application   MembershipApplication? @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens PasswordResetToken[]
  alumniProfile       AlumniProfile?
  duesPayments        DuesPayment[]
  barrierReports      BarrierReport[]
  supportRequests     SupportRequest[]
  mentorships         Mentorship[]
  studyGroups         StudyGroupMember[]
  createdStudyGroups  StudyGroup[]         @relation("StudyGroupCreator")
  softwareRequests    SoftwareRequest[]
  cv                  MemberCv?
  documentPurchases   DocumentPurchase[]
  candidacies         ElectionCandidate[]
  electionsVotedIn    ElectionVoter[]
  // The public Leadership/Patron listing this account is linked to, if any
  // — the far side of TeamMember.memberId, used to charge the Executive
  // dues rate instead of the level/track rate.
  teamMemberLink      TeamMember?

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("members")
}

model MembershipApplication {
  id String @id @default(cuid())

  firstName       String
  middleName      String?
  lastName        String
  dateOfBirth     DateTime
  gender          Gender
  profileImageUrl String?
  phone           String
  email           String

  indexNumber            String            @unique
  applicationTrack       ApplicationTrack?
  degreeCategory         String?
  programme              String
  department             String
  academicDepartment     String?
  hallOfAffiliation      String?
  specificSupportNeeds   String[]          @default([])
  level                  String
  campus                 String
  yearOfAdmission        Int
  expectedGraduationYear Int?

  medicalReportUrl String?

  residentialAddress    String
  region                String
  emergencyContactName  String
  emergencyContactPhone String

  membershipType   MembershipType?
  additionalFields Json?

  agreedToTerms Boolean @default(false)

  status       ApplicationStatus @default(PENDING)
  reviewedById String?
  reviewedBy   AdminUser?        @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  adminNote    String?

  // Set only when an alumnus submitted this application to become a current
  // member again (see AlumniProfile.furtherStudiesApplications) — null for
  // every ordinary first-time enrollment. On approval, the resulting Member
  // gets linked back to this same AlumniProfile, so they can log into both
  // portals.
  submittedByAlumniId String?
  submittedByAlumni   AlumniProfile? @relation(fields: [submittedByAlumniId], references: [id])

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  member            Member?
  studentEnrollment StudentEnrollment?

  @@index([status])
  @@index([submittedAt])
  @@map("membership_applications")
}

/// A one-time link for an administrator to set their own password —
/// either the first one, on an account just created for them, or a
/// replacement if the first link expired.
///
/// The account is created with no usable password at all, so an invitation
/// is the only way in. That means nobody ever has to send a colleague a
/// password, and no temporary one sits in an inbox waiting to be found.
model AdminPasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@map("admin_password_reset_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([memberId])
  @@map("password_reset_tokens")
}

// ==================================================================
// NEWS
// ==================================================================

model NewsCategory {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique
  news News[]

  @@map("news_categories")
}

model News {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String
  body          String
  coverImageUrl String?
  images        String[]      @default([])
  authorId      String?
  author        AdminUser?    @relation(fields: [authorId], references: [id])
  categoryId    String?
  category      NewsCategory? @relation(fields: [categoryId], references: [id])
  tags          String[]      @default([])
  status        ContentStatus @default(DRAFT)
  featured      Boolean       @default(false)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, publishedAt])
  @@index([slug])
  @@map("news")
}

// ==================================================================
// EVENTS
// ==================================================================

model EventCategory {
  id     String  @id @default(cuid())
  name   String  @unique
  slug   String  @unique
  events Event[]

  @@map("event_categories")
}

model Event {
  id               String         @id @default(cuid())
  title            String
  slug             String         @unique
  description      String
  shortDescription String?
  imageUrl         String?
  galleryImages    String[]       @default([])
  documents        String[]       @default([])
  startDate        DateTime
  endDate          DateTime
  startTime        String?
  endTime          String?
  venue            String
  organizer        String?
  contactInfo      String?
  registrationLink String?
  externalLink     String?
  categoryId       String?
  category         EventCategory? @relation(fields: [categoryId], references: [id])
  featured         Boolean        @default(false)
  status           ContentStatus  @default(DRAFT)
  createdById      String?
  createdBy        AdminUser?     @relation(fields: [createdById], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, startDate])
  @@index([slug])
  @@map("events")
}

// ==================================================================
// LIBRARY
// ==================================================================

enum DocumentAudience {
  PUBLIC
  PATRONS
}

model DocumentCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  documents Document[]

  @@map("document_categories")
}

model Document {
  id                 String            @id @default(cuid())
  title              String
  description        String?
  categoryId         String?
  category           DocumentCategory? @relation(fields: [categoryId], references: [id])
  r2ObjectKey        String
  publicUrl          String?
  mimeType           String
  fileSize           Int
  thumbnailUrl       String?
  version            String?
  featured           Boolean           @default(false)
  status             ContentStatus     @default(DRAFT)
  isPublic           Boolean           @default(true)
  // Who may read it once published: everyone (the public library) or only
  // signed-in patrons (the Patrons' Portal governance library).
  audience           DocumentAudience  @default(PUBLIC)
  uploadedById       String?
  uploadedBy         AdminUser?        @relation(fields: [uploadedById], references: [id])
  // Set when a patron uploaded it from the Patrons' Portal. Such a document
  // starts as a DRAFT for the patrons audience and is shared only once an
  // administrator publishes it.
  uploadedByPatronId String?
  uploadedByPatron   PatronProfile?    @relation(fields: [uploadedByPatronId], references: [id], onDelete: SetNull)
  downloadCount      Int               @default(0)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([status])
  @@index([categoryId])
  @@index([audience])
  @@index([uploadedByPatronId])
  @@map("documents")
}

// ==================================================================
// ELECTIONS (future-ready: candidates + results modeled now, no
// voting engine implemented yet)
// ==================================================================

model Election {
  id               String        @id @default(cuid())
  title            String
  description      String?
  status           ContentStatus @default(DRAFT)

  /// Where the ballot stands. Separate from `status`, which only decides
  /// whether the election has a page on the website.
  phase          ElectionPhase @default(SCHEDULED)
  /// When the terminals will accept a vote. The Electoral Commission can
  /// move `votingClosesAt` later while voting is under way — a late start
  /// at one centre shouldn't cost everybody their last hour.
  votingOpensAt  DateTime?
  votingClosesAt DateTime?
  /// Why the commission stopped or moved it — read out at the terminals
  /// and shown on the website.
  noticeText     String?
  /// The commission's switch for the public results page.
  resultsPublic  Boolean       @default(false)
  nominationStart  DateTime?
  nominationEnd    DateTime?
  votingDate       DateTime?
  venueOrMethod    String?
  rulesDocumentUrl String?
  resultsSummary   String?
  images           String[]      @default([])
  documents        String[]      @default([])
  createdById      String?
  createdBy        AdminUser?    @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  candidates ElectionCandidate[]
  positions  ElectionPosition[]
  ballots    ElectionBallot[]
  voters     ElectionVoter[]

  @@map("elections")
}

/// A post being contested — President, Secretary. The commission sets
/// these first; members then nominate themselves for one of them, and the
/// terminals show one screen per portfolio, in this order.
model ElectionPosition {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  title      String
  /// Where it comes on the ballot: president first, and so on down.
  order      Int      @default(0)
  /// What a member pays for the form to stand for this post. Zero means
  /// no charge — some posts go uncontested, and the commission would
  /// rather have a candidate than a fee.
  nominationFeePesewas Int @default(0)
  createdAt  DateTime @default(now())

  candidates    ElectionCandidate[]
  formPurchases DocumentPurchase[]

  @@unique([electionId, title])
  @@map("election_positions")
}

model ElectionCandidate {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  name       String
  /// The portfolio as typed. Kept alongside `positionId` because entries
  /// made before there were portfolios have nothing else to show.
  position   String
  photoUrl   String?
  manifesto  String?
  voteCount  Int      @default(0)
  createdAt  DateTime @default(now())

  /// Set once the candidate is on a real ballot paper; without it the
  /// entry is only a name on the website.
  positionId String?
  portfolio  ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  /// The member who put themselves forward, where they did. Null for an
  /// entry the commission typed in itself.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  /// Defaults to APPROVED so entries made before nominations existed keep
  /// showing; a self-nomination starts PENDING and waits for the commission.
  status       CandidateStatus @default(APPROVED)
  reviewNote   String?
  reviewedById String?
  reviewedBy   AdminUser?      @relation("CandidateReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  /// What they put forward with their nomination: the CV the portal
  /// prepared for them, or a document or picture of their own.
  supportingUrl  String?
  supportingName String?
  usedPortalCv   Boolean @default(false)

  choices ElectionVoteChoice[]

  /// One nomination per member per portfolio. Postgres counts NULLs as
  /// distinct, so the commission's own entries are unaffected.
  @@unique([electionId, memberId, positionId])
  @@index([electionId, status])
  @@map("election_candidates")
}

/// A terminal standing in a polling centre. It identifies itself with the
/// code below and a key it is given once at registration; only the hash of
/// that key is kept here.
model PollingStation {
  id         String    @id @default(cuid())
  code       String    @unique
  name       String
  keyHash    String
  isActive   Boolean   @default(true)
  /// Last time this terminal asked the portal anything — how the
  /// commission sees that a centre is up without ringing it.
  lastSeenAt DateTime?

  createdById String?
  createdBy   AdminUser? @relation("StationRegistrar", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())

  ballots ElectionBallot[]

  @@map("polling_stations")
}

/// Who has voted. Never what they voted for: there is no candidate on this
/// table and no member on the ballot table, and nothing joins the two.
model ElectionVoter {
  id          String   @id @default(cuid())
  electionId  String
  election    Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  votedAt     DateTime @default(now())
  stationCode String?

  @@unique([electionId, memberId])
  @@map("election_voters")
}

/// One completed ballot paper, with nobody's name on it.
model ElectionBallot {
  id         String   @id @default(cuid())
  electionId String
  election   Election @relation(fields: [electionId], references: [id], onDelete: Cascade)
  /// The terminal's own id for this paper. A vote that was queued offline
  /// and sent twice when the line came back is recognised, not counted twice.
  clientRef  String   @unique
  /// Deliberately rounded down to the hour: enough to see turnout through
  /// the day, not enough to line a ballot up against the roll by its
  /// timestamp and work out who cast it.
  castHour   DateTime
  stationId  String?
  station    PollingStation? @relation(fields: [stationId], references: [id], onDelete: SetNull)

  choices ElectionVoteChoice[]

  @@index([electionId])
  @@map("election_ballots")
}

model ElectionVoteChoice {
  id          String            @id @default(cuid())
  ballotId    String
  ballot      ElectionBallot    @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   ElectionCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  positionId  String?

  /// Where only one person stands, the question is not who but whether —
  /// so a mark against the single candidate can be a no. Everything with
  /// a real contest is always true.
  approve     Boolean           @default(true)

  /// One mark per portfolio per paper, enforced here rather than trusted
  /// from the terminal.
  @@unique([ballotId, positionId])
  @@index([candidateId])
  @@map("election_vote_choices")
}

// ==================================================================
// SITE CONTENT
// ==================================================================

model HeroSlide {
  id              String   @id @default(cuid())
  title           String
  subtitle        String?
  imageUrl        String?
  backgroundColor String?
  ctaText         String?
  ctaUrl          String?
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("hero_slides")
}

model AboutContent {
  id                    String   @id @default("default")
  mission               String?
  vision                String?
  coreValues            String?
  history               String?
  objectives            String?
  leadershipMessage     String?
  membershipEligibility String?
  partnersStakeholders  String?
  imageUrl              String?
  updatedAt             DateTime @updatedAt

  @@map("about_content")
}

model TeamMember {
  id        String         @id @default(cuid())
  type      TeamMemberType
  name      String
  position  String
  photoUrl  String?
  bio       String?
  order     Int            @default(0)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // Optional link to the actual paying member account this listing
  // represents, so dues can charge the Executive rate without a second,
  // separate "who's an executive" record to keep in sync. Not every
  // TeamMember has one — Patrons never do, and a Leadership entry can
  // exist on the public page before (or without) a matching account.
  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id])

  @@index([type])
  @@map("team_members")
}

model DonateContent {
  id                 String   @id @default("default")
  title              String?
  description        String?
  instructions       String?
  bankDetails        String?
  mobileMoneyDetails String?
  paymentGatewayUrl  String?
  qrCodeImageUrl     String?
  contactInfo        String?
  bannerImageUrl     String?
  updatedAt          DateTime @updatedAt

  @@map("donate_content")
}

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  @@map("site_settings")
}

model SocialLink {
  id          String         @id @default(cuid())
  platform    SocialPlatform
  displayName String
  url         String
  isActive    Boolean        @default(true)
  order       Int            @default(0)

  @@map("social_links")
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  status    MessageStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
  @@map("contact_messages")
}

/// What a picture shows, in words, for anyone who cannot see it.
///
/// Keyed by the picture’s own public URL rather than held on each model, so
/// one description covers wherever that picture is used — a news cover, an
/// event banner, a hero slide — and pictures already uploaded can be
/// described later without touching the records that point at them.
model ImageDescription {
  id          String     @id @default(cuid())
  url         String     @unique
  description String
  updatedById String?
  updatedBy   AdminUser? @relation(fields: [updatedById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("image_descriptions")
}

model Media {
  id           String        @id @default(cuid())
  filename     String
  category     MediaCategory @default(OTHER)
  r2ObjectKey  String
  publicUrl    String?
  mimeType     String
  fileSize     Int
  altText      String?
  width        Int?
  height       Int?
  uploadedById String?
  uploadedBy   AdminUser?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime      @default(now())

  @@map("media")
}

model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead])
  @@map("notifications")
}

model AuditLog {
  id            String     @id @default(cuid())
  adminId       String?
  admin         AdminUser? @relation(fields: [adminId], references: [id])
  action        String
  entityType    String
  entityId      String?
  previousValue Json?
  newValue      Json?
  note          String?
  createdAt     DateTime   @default(now())

  @@index([entityType, entityId])
  @@map("audit_logs")
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED_NO_PROVIDER
}

model EmailLog {
  id           String      @id @default(cuid())
  to           String
  subject      String
  template     String
  status       EmailStatus
  attempts     Int         @default(1)
  errorMessage String?
  entityType   String?
  entityId     String?
  createdAt    DateTime    @default(now())

  @@index([to])
  @@index([status])
  @@index([entityType, entityId])
  @@map("email_logs")
}

// ---------------------------------------------------------------------------
// Alumni Network
// ---------------------------------------------------------------------------

enum AlumniStatus {
  ACTIVE
  SUSPENDED
}

model AlumniProfile {
  id              String       @id @default(cuid())
  fullName        String
  email           String       @unique
  phone           String
  passwordHash    String?
  mustSetPassword Boolean      @default(false)
  graduationYear  Int
  programme       String
  profession      String?
  currentLocation String?
  profileImageUrl String?
  bio             String?
  willingToMentor Boolean      @default(false)
  status          AlumniStatus @default(ACTIVE)

  // Mentoring, in the mentor's own words: when they're generally free, and
  // how many students they're willing to take at once. Only read while
  // willingToMentor is on.
  mentorAvailability String?
  mentorCapacity     Int     @default(3)

  // Visible in the members-only directory to other signed-in alumni. This
  // has never meant "visible on the public web" and still doesn't — see
  // publicProfile below, which is the separate, deliberately stricter gate.
  directoryVisible Boolean @default(true)

  // Opt-in to appearing anywhere on the PUBLIC site. Defaults to false for
  // everyone, including every alumnus who already existed: nobody's details
  // reach the open web without a deliberate decision. Being public is not
  // the same as being featured — a public profile is reachable and listed,
  // a featured one additionally gets a spotlight (see AlumniSpotlight).
  publicProfile Boolean @default(false)
  // Address of the public profile page, /alumni/[publicSlug]. Nullable
  // because it's only minted when a profile is first made public.
  publicSlug    String? @unique

  // Professional detail, shown publicly only when publicProfile is set.
  currentPosition     String?
  currentOrganization String?
  industry            String?
  country             String?
  achievements        String[] @default([])

  linkedinUrl  String?
  twitterUrl   String?
  facebookUrl  String?
  instagramUrl String?
  websiteUrl   String?

  // The Member row this alumni is currently also linked to, if any — either
  // set automatically because this profile was created FROM a graduating
  // student (see promoteMemberToAlumni), or set later when a self-registered
  // alumnus submits a further-studies application that gets approved (see
  // submitFurtherStudiesApplication / approveApplication). Either way it
  // means "this person can currently log into both the member and alumni
  // portals" — there is at most one CURRENT such Member at a time, though an
  // alumnus may have completed (and left linked here as history) more than
  // one enrollment across their lifetime.
  sourceMemberId String? @unique
  sourceMember   Member? @relation(fields: [sourceMemberId], references: [id])

  furtherStudiesApplications MembershipApplication[]

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  passwordResetTokens AlumniPasswordResetToken[]
  spotlight           AlumniSpotlight?
  mentorships         Mentorship[]
  opportunities       Opportunity[]
  donations           Donation[]
  endorsements        CampaignEndorsement[]
  priorProgrammes     AlumniPriorProgramme[]

  @@index([status])
  @@index([willingToMentor])
  @@index([directoryVisible])
  @@index([publicProfile])
  @@map("alumni_profiles")
  cv                MemberCv?
  documentPurchases DocumentPurchase[]
}

/// The showcase presentation of an alumnus — the editorial layer on top of
/// their account, not a second account. One identity, one AlumniProfile;
/// this row exists only for the people an administrator has chosen to put
/// forward, and deleting it removes the spotlight without touching their
/// account or their ability to sign in.
model AlumniSpotlight {
  id       String        @id @default(cuid())
  alumniId String        @unique
  alumni   AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  /// Short editorial line for the card, e.g. "Building accessible software".
  headline String?
  /// One or two sentences of achievement summary, shown on the card.
  summary  String?
  /// Long-form spotlight story shown on the profile page.
  story    String?
  /// Optional replacement for the account's own profile photo, so a casual
  /// avatar doesn't have to double as a public feature image.
  imageUrl String?
  /// Achievement category, e.g. "Technology". Free text for now so admins
  /// aren't blocked on a fixed list.
  category String?
  quote    String?

  displayOrder   Int     @default(0)
  showOnHomepage Boolean @default(false)
  /// Nothing reaches the public site until this is true, independently of
  /// whether the profile itself is public — so a spotlight can be drafted
  /// and reviewed before anyone sees it.
  published      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, displayOrder])
  @@map("alumni_spotlights")
}

/// Admin-editable copy for the public /alumni page. Singleton, following
/// the same "default" row pattern as AboutContent, so the wording is never
/// hard-coded in the page.
model AlumniPageContent {
  id String @id @default("default")

  heroKicker      String  @default("Alumni Network")
  heroTitle       String  @default("Our Proud Alumni")
  heroDescription String  @default("Our alumni continue to make meaningful contributions across their professions, communities, and the world. Discover the people who represent the impact of our association beyond graduation.")
  heroImageUrl    String?

  showcaseTitle       String @default("Our Proud Alumni")
  showcaseDescription String @default("Graduates of the association making an impact in their fields.")

  updatedAt DateTime @default(now()) @updatedAt

  @@map("alumni_page_content")
}

model AlumniPasswordResetToken {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  alumniId  String
  alumni    AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([alumniId])
  @@map("alumni_password_reset_tokens")
}

// ---------------------------------------------------------------------------
// Rate limiting
// ---------------------------------------------------------------------------

/**
 * Each row is one attempt at something worth rate-limiting (a login try,
 * a password reset request, a form submission). Checking a rate limit
 * means counting recent rows for a given key; enforcing it means writing
 * a new row after every attempt. Old rows are opportunistically cleaned up
 * so this table doesn't grow unbounded. Backed by the database (rather
 * than an external service like Redis) so it works correctly across
 * Vercel's many separate serverless instances without asking for another
 * account/signup.
 */
model RateLimitAttempt {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@map("rate_limit_attempts")
}

// ==================================================================
// UNIFIED IDENTITY (dual-status architecture)
//
// One human = one User row = one login, regardless of how many hats
// they wear. The tables below exist alongside the original Member /
// AlumniProfile / AdminUser records during the migration: those still
// own authentication today, while these are backfilled and dormant.
// Auth moves over in a later stage, and the legacy columns retire only
// once that's proven — so a problem at any point is a rollback, not a
// lockout.
// ==================================================================

enum UserRoleName {
  MEMBER
  ALUMNI
  ADMIN
}

enum EnrollmentStatus {
  ACTIVE
  GRADUATED
  SUSPENDED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  // Person-level details, as opposed to the per-enrollment academic
  // fields on StudentEnrollment. Kept here so this row can stand on its
  // own once the legacy tables are retired.
  firstName  String
  middleName String?
  lastName   String
  phone      String?

  mustChangePassword Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles       UserRole[]
  enrollments StudentEnrollment[]

  // Back-references to the legacy records this user was built from, so
  // the two models can be reconciled in either direction mid-migration.
  member        Member?
  alumniProfile AlumniProfile?
  adminUser     AdminUser?

  @@map("users")
}

model UserRole {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   UserRoleName

  createdAt DateTime @default(now())

  // A role is granted once per user — "grant dual status" is an insert
  // here, and this stops it being granted twice.
  @@unique([userId, role])
  @@index([role])
  @@map("user_roles")
}

// One row per period of study. A returning student gets a NEW row with
// their NEW index number rather than having the old one overwritten —
// which is what makes a changing index number a non-event, and keeps
// their earlier studies on the record instead of erasing them.
model StudentEnrollment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  indexNumber String @unique

  applicationTrack       ApplicationTrack?
  degreeCategory         String?
  programme              String
  academicDepartment     String?
  level                  String
  campus                 String
  hallOfAffiliation      String?
  yearOfAdmission        Int
  expectedGraduationYear Int?

  // Category of special needs, matching the naming the rest of the
  // schema already uses for this field.
  department           String
  specificSupportNeeds String[] @default([])

  membershipType MembershipType?
  status         EnrollmentStatus @default(ACTIVE)
  graduatedAt    DateTime?

  // The application this enrollment cycle came from, where there was
  // one (a backfilled historical enrollment may have none).
  applicationId String?                @unique
  application   MembershipApplication? @relation(fields: [applicationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("student_enrollments")
}

// ==================================================================
// Membership dues (Paystack)
// ==================================================================

enum DuesPaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Documents the association prepares for a member for a fee.
enum PaidDocumentKind {
  CV
  ID_CARD
  /// The form a member buys in order to stand for a particular post.
  NOMINATION_FORM
}

enum DocumentPurchaseStatus {
  PENDING
  SUCCESS
  FAILED
}

/// How a CV is signed. Drawing with a mouse is no use to somebody who
/// cannot see the pad, so typed initials count as a signature here.
enum SignatureKind {
  NONE
  DRAWN
  TYPED
}

/**
 * One row per payment attempt, not per member-year — a failed or abandoned
 * attempt is kept rather than overwritten, so retrying after a declined
 * card doesn't erase the evidence of what happened. Whether a member "has
 * paid" for a given academicYear is a query (a SUCCESS row for that year),
 * not a flag anywhere.
 */
// ---------------------------------------------------------------------------
// Patrons
// ---------------------------------------------------------------------------

enum PatronStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

/**
 * A patron of the association — a lecturer, professional, benefactor or
 * friend of the association — who applies online at /patrons/register and
 * is approved by an administrator before they can sign in to the Patrons'
 * Portal.
 * Deliberately separate from the student and alumni identities: patrons are
 * usually neither, so they have their own record, their own sign-in and
 * their own session (see lib/auth/patron.ts). Being approved here is about
 * portal access; the profiles shown on the public Patrons page are managed
 * separately, in Admin > Patrons > Public Profiles.
 */
model PatronProfile {
  id              String  @id @default(cuid())
  // Prof., Dr., Rev. … — optional, and used to greet them in emails.
  title           String?
  fullName        String
  email           String  @unique
  phone           String
  // Their work: occupation/profession, and where and as what they do it.
  occupation      String
  organization    String?
  jobTitle        String?
  address         String?
  region          String?
  // From the application form: how they'd like to support the association,
  // and why they want to become a patron.
  supportInterest String?
  motivation      String?
  // Chosen when applying; usable only once the application is approved.
  passwordHash    String

  status       PatronStatus @default(PENDING)
  reviewedById String?
  reviewedBy   AdminUser?   @relation("PatronReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?
  // Shown to the applicant when an application is rejected or an account
  // suspended.
  adminNote    String?

  // When they last opened the notifications menu in the portal; anything
  // newer counts as unread.
  notificationsSeenAt DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations    Donation[]
  broadcasts   Broadcast[]
  threads      PatronThread[]
  endorsements CampaignEndorsement[]
  issueActions IssuePatronAction[]
  documents    Document[]

  @@index([status])
  @@index([submittedAt])
  @@map("patron_profiles")
}

model DuesPayment {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // e.g. "2026/2027" — see getCurrentAcademicYear() in dues-service.ts.
  // Stored rather than derived from createdAt so a payment always reports
  // the year it was FOR even if verification lands after the cutover.
  academicYear String

  // Human label for the tier this was charged at (e.g. "Level 100
  // (Fresher)", "Executive"), captured at charge time so a later change to
  // the fee schedule doesn't rewrite what someone actually paid for.
  tierLabel String

  // Smallest currency unit (pesewas — 100 = GHS 1.00), matching what
  // Paystack's API itself expects and returns for GHS.
  amountPesewas Int

  status DuesPaymentStatus @default(PENDING)

  // The value sent to Paystack as the transaction reference — generated
  // here (not by Paystack) so it can be created before the API call and
  // used to look the payment back up from the callback/webhook.
  reference             String    @unique
  paystackTransactionId String?
  paidAt                DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([academicYear])
  @@index([status])
  @@map("dues_payments")
}

// ---------------------------------------------------------------------------
// Patrons' Portal: finances
// ---------------------------------------------------------------------------

/// The causes a donation can be given to.
enum DonationFund {
  GENERAL
  ASSISTIVE_TECHNOLOGY
  EMERGENCY_WELFARE
  ADVOCACY_LEGAL
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DonationSource {
  // Paid online through Paystack.
  ONLINE
  // Received another way (cash, bank transfer, cheque) and entered by an
  // administrator.
  RECORDED
}

/// One donation, or one attempt at an online donation. Like DuesPayment, a
/// failed or abandoned attempt is kept rather than overwritten; only SUCCESS
/// rows count as money raised.
/// What a member typed into the CV form. Kept so they can come back and
/// change one line rather than starting again, and so a fresh PDF can be
/// made whenever they want one.
model MemberCv {
  id String @id @default(cuid())

  /// Exactly one of these. A CV belongs to a student or to a graduate,
  /// and a graduate who was once a student keeps writing the same one.
  memberId        String?        @unique
  member          Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  alumniProfileId String?        @unique
  alumniProfile   AlumniProfile? @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  /// Under the name: "Final-year special education student seeking…".
  headline String?
  summary  String?
  /// Where employers should write, which is not always the address on file.
  contactEmail String?
  contactPhone String?
  location     String?

  /// Repeating sections, each a list of objects — see validations/cv.ts for
  /// their shape. A column apiece would be five more tables for something
  /// only ever read and written whole.
  education   Json @default("[]")
  experience  Json @default("[]")
  skills      Json @default("[]")
  languages   Json @default("[]")
  activities  Json @default("[]")
  referees    Json @default("[]")

  /// Either a PNG of what they drew, or the letters they typed — see
  /// SignatureKind. Kept with the CV because it is part of the document,
  /// not part of the account.
  signatureKind SignatureKind @default(NONE)
  signatureData String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("member_cvs")
}

/// A member paying for a document the association prepares for them.
///
/// Deliberately not specific to the CV: the ID card is the same
/// transaction with a different word in it, and this is what it will use
/// when it stops being an admin-only favour.
model DocumentPurchase {
  id String @id @default(cuid())

  /// Exactly one of these, matching whoever is buying.
  memberId        String?
  member          Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  alumniProfileId String?
  alumniProfile   AlumniProfile? @relation(fields: [alumniProfileId], references: [id], onDelete: Cascade)

  kind PaidDocumentKind

  /// Which post the form was bought for, when it is a nomination form.
  positionId String?
  position   ElectionPosition? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  /// Smallest currency unit (pesewas), as everywhere else money is stored.
  amountPesewas Int
  /// The tariff at the time of paying, so changing the price later never
  /// rewrites what somebody actually paid.
  priceLabel String

  status DocumentPurchaseStatus @default(PENDING)

  /// Generated here, before Paystack is called, so the callback and the
  /// webhook have something to look the payment back up by.
  reference             String    @unique
  paystackTransactionId String?
  paidAt                DateTime?

  /// When this stops counting as paid. Null means never: a student pays
  /// for their CV once and it is theirs. A graduate's is renewed yearly,
  /// because the association keeps preparing it for them.
  validUntil DateTime?

  /// Set when an officer took the money in cash and recorded it.
  recordedById String?
  recordedBy   AdminUser? @relation("DocumentPurchaseRecorder", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId, kind, status])
  @@index([alumniProfileId, kind, status])
  @@map("document_purchases")
}

model Donation {
  id       String         @id @default(cuid())
  // The patron who gave it, when it was given from the Patrons' Portal.
  patronId String?
  patron   PatronProfile? @relation(fields: [patronId], references: [id], onDelete: SetNull)
  // The alumnus who gave it, when it was given from the Alumni Portal. A
  // donation has at most one of these — they are two different portals, not
  // two names for the same giver.
  alumniId String?
  alumni   AlumniProfile? @relation(fields: [alumniId], references: [id], onDelete: SetNull)

  // Captured when the donation is made, so the record still reads correctly
  // if the patron account is later removed.
  donorName  String
  donorEmail String?

  fund          DonationFund @default(GENERAL)
  // Pesewas (100 = GHS 1.00), as with dues.
  amountPesewas Int
  // Anonymous donations never appear on the Patron Honor Roll.
  anonymous     Boolean      @default(false)

  source                DonationSource @default(ONLINE)
  status                DonationStatus @default(PENDING)
  reference             String         @unique
  paystackTransactionId String?
  paidAt                DateTime?
  note                  String?

  recordedById String?
  recordedBy   AdminUser? @relation("DonationRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([patronId])
  @@index([alumniId])
  @@index([paidAt])
  @@map("donations")
}

/// How the association's spending is grouped in the finance charts.
enum ExpenseCategory {
  STUDENT_WELFARE
  EVENTS
  ASSISTIVE_TECHNOLOGY
  ADVOCACY
  ADMINISTRATION
  OTHER
}

/// Money the association spent, recorded by an administrator.
model Expense {
  id            String          @id @default(cuid())
  category      ExpenseCategory
  description   String
  amountPesewas Int
  spentOn       DateTime

  recordedById String?
  recordedBy   AdminUser? @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  /// The student support request this payout settled, where it was one.
  supportRequest SupportRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([spentOn])
  @@index([category])
  @@map("expenses")
}

// ---------------------------------------------------------------------------
// Patrons' Portal: communication
// ---------------------------------------------------------------------------

enum BroadcastAudience {
  ALL_MEMBERS
  STUDENTS
  ALUMNI
  EXECUTIVES
  PATRONS
  ALLIES
}

enum BroadcastStatus {
  // Waiting for an administrator.
  PENDING
  // Approved and sent.
  APPROVED
  REJECTED
}

/// A message a patron wants sent to a group of members. Nothing is sent
/// until an administrator approves it; approval posts it to the chosen
/// portals and emails the group.
model Broadcast {
  id               String         @id @default(cuid())
  patronId         String?
  patron           PatronProfile? @relation(fields: [patronId], references: [id], onDelete: SetNull)
  // Set instead of patronId when an executive wrote it in the admin area.
  // Executives send their own broadcasts directly: there is nobody above
  // them to approve it, so these rows are created already APPROVED.
  createdByAdminId String?
  createdByAdmin   AdminUser?     @relation("BroadcastAuthor", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  // The sender's name as shown to members, captured when it was written.
  authorName       String

  audience     BroadcastAudience
  sendEmail    Boolean           @default(true)
  postToPortal Boolean           @default(true)
  subject      String
  // Sanitised rich text.
  bodyHtml     String

  // An optional attached letter or statement, stored in R2.
  attachmentKey  String?
  attachmentName String?
  attachmentMime String?
  attachmentSize Int?

  status       BroadcastStatus @default(PENDING)
  reviewedById String?
  reviewedBy   AdminUser?      @relation("BroadcastReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  sentAt         DateTime?
  recipientCount Int?
  emailsSent     Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([patronId])
  @@index([sentAt])
  @@map("broadcasts")
}

enum PatronThreadStatus {
  OPEN
  CLOSED
}

enum PatronMessageSender {
  PATRON
  ADMIN
}

/// A private conversation between one patron and the executive team.
model PatronThread {
  id       String        @id @default(cuid())
  patronId String
  patron   PatronProfile @relation(fields: [patronId], references: [id], onDelete: Cascade)

  subject     String
  // Who the patron addressed it to, e.g. "President" or "Executive Committee".
  addressedTo String
  status      PatronThreadStatus @default(OPEN)

  lastMessageAt  DateTime @default(now())
  unreadByPatron Boolean  @default(false)
  unreadByAdmin  Boolean  @default(true)

  messages PatronMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patronId])
  @@index([lastMessageAt])
  @@index([unreadByAdmin])
  @@map("patron_threads")
}

model PatronMessage {
  id       String       @id @default(cuid())
  threadId String
  thread   PatronThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  sender  PatronMessageSender
  // The administrator who replied, for ADMIN messages.
  adminId String?
  admin   AdminUser?          @relation("PatronMessageAuthor", fields: [adminId], references: [id], onDelete: SetNull)
  body    String

  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
  @@map("patron_messages")
}

// ---------------------------------------------------------------------------
// Patrons' Portal: advocacy and rights
// ---------------------------------------------------------------------------

enum CampaignStatus {
  ACTIVE
  ACHIEVED
  CLOSED
}

/// A rights or policy campaign patrons can officially endorse.
model AdvocacyCampaign {
  id          String         @id @default(cuid())
  title       String
  summary     String
  details     String?
  // Who started it, e.g. "Students' Executive Committee".
  initiatedBy String?
  // Who it asks for change, e.g. "University Management".
  targetBody  String?
  status      CampaignStatus @default(ACTIVE)

  createdById String?
  createdBy   AdminUser? @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)

  endorsements CampaignEndorsement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("advocacy_campaigns")
}

/// One signature on a campaign. A patron's carries the patron's seal; an
/// alumnus co-signs as a graduate backing the students. Exactly one of
/// patronId and alumniId is set — which one is what the endorsement means.
model CampaignEndorsement {
  id         String           @id @default(cuid())
  campaignId String
  campaign   AdvocacyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  patronId   String?
  patron     PatronProfile?   @relation(fields: [patronId], references: [id], onDelete: Cascade)
  alumniId   String?
  alumni     AlumniProfile?   @relation(fields: [alumniId], references: [id], onDelete: Cascade)
  comment    String?

  createdAt DateTime @default(now())

  @@unique([campaignId, patronId])
  @@unique([campaignId, alumniId])
  @@map("campaign_endorsements")
}

enum IssueStatus {
  SUBMITTED
  UNDER_REVIEW
  PATRON_ACTION
  RESOLVED
}

enum IssueCategory {
  EXAMINATION_VENUES
  LEARNING_MATERIALS
  PHYSICAL_ACCESS
  ASSISTIVE_TECHNOLOGY
  ACCOMMODATION
  DISCRIMINATION
  OTHER
}

/// A rights or accessibility problem on campus, escalated to the patrons by
/// the executive team. Written as a summary, never with the names or health
/// details of the students affected.
model AccessibilityIssue {
  id             String        @id @default(cuid())
  title          String
  summary        String
  category       IssueCategory
  location       String?
  status         IssueStatus   @default(SUBMITTED)
  reportedOn     DateTime      @default(now())
  resolvedAt     DateTime?
  resolutionNote String?

  createdById String?
  createdBy   AdminUser? @relation("IssueCreator", fields: [createdById], references: [id], onDelete: SetNull)

  actions      IssuePatronAction[]
  /// The student's own report this was escalated from, where there was one.
  sourceReport BarrierReport?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("accessibility_issues")
}

enum IssueActionType {
  MEETING_REQUEST
  OFFICIAL_STATEMENT
}

/// A patron asking for a meeting with management, or making a statement, on an issue.
model IssuePatronAction {
  id       String             @id @default(cuid())
  issueId  String
  issue    AccessibilityIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  patronId String
  patron   PatronProfile      @relation(fields: [patronId], references: [id], onDelete: Cascade)
  type     IssueActionType
  message  String

  createdAt DateTime @default(now())

  @@index([issueId])
  @@map("issue_patron_actions")
}

// ---------------------------------------------------------------------------
// Student Portal: rights, barriers and support
// ---------------------------------------------------------------------------

/// Where a student's barrier report has got to. Deliberately longer than the
/// patrons' IssueStatus: this is the working queue the executives triage,
/// and ESCALATED is the point where a de-identified summary crosses over
/// into the patrons' advocacy log.
enum BarrierReportStatus {
  SUBMITTED
  UNDER_REVIEW
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

/// A barrier a student ran into on campus — a locked lift, an exam venue
/// upstairs, an exam paper with no audio version — reported from the Student
/// Portal with photos or a voice note as evidence.
///
/// This is the student's own account, with their name attached, and it stays
/// with the executive team. What reaches the patrons is the separate,
/// de-identified AccessibilityIssue an executive writes when escalating (see
/// escalatedIssue below).
model BarrierReport {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  title       String
  description String
  category    IssueCategory
  location    String?
  /// When the student hit the barrier, if they said.
  occurredOn  DateTime?

  status BarrierReportStatus @default(SUBMITTED)

  /// The executive handling it, e.g. the PRO.
  assignedToId String?
  assignedTo   AdminUser? @relation("BarrierReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolutionNote String?
  resolvedAt     DateTime?

  /// Set when an executive escalates it to the patrons.
  escalatedIssueId String?             @unique
  escalatedIssue   AccessibilityIssue? @relation(fields: [escalatedIssueId], references: [id], onDelete: SetNull)

  attachments BarrierReportAttachment[]
  updates     BarrierReportUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([memberId])
  @@map("barrier_reports")
}

/// A photo, voice note or document a student attached to a report. Stored in
/// R2 and only ever served to the student who filed it or an administrator.
model BarrierReportAttachment {
  id       String        @id @default(cuid())
  reportId String
  report   BarrierReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  objectKey String
  fileName  String
  mimeType  String
  fileSize  Int

  createdAt DateTime @default(now())

  @@index([reportId])
  @@map("barrier_report_attachments")
}

/// A note on a report's progress. Everything here is shown to the student who
/// filed it — it is what makes the tracker on their dashboard truthful.
model BarrierReportUpdate {
  id       String        @id @default(cuid())
  reportId String
  report   BarrierReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  adminId    String?
  admin      AdminUser? @relation("BarrierReportUpdateAuthor", fields: [adminId], references: [id], onDelete: SetNull)
  /// Captured when written, so the note still reads correctly if the
  /// administrator's account is later removed.
  authorName String

  body   String
  /// The status the report moved to with this note, when it moved.
  status BarrierReportStatus?

  createdAt DateTime @default(now())

  @@index([reportId, createdAt])
  @@map("barrier_report_updates")
}

/// The kinds of help a student can ask the association for.
enum SupportRequestType {
  ASSISTIVE_TECH
  NOTE_TAKER
  WELFARE
  OTHER
}

enum SupportRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DECLINED
  FULFILLED
}

/// One request for assistive technology, a lecture note-taker, or welfare
/// support. Financial requests carry an amount; the executive who approves a
/// payout records the spending against it, which is what links the welfare
/// fund to the finance ledger.
model SupportRequest {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  type                   SupportRequestType
  details                String
  /// Pesewas, for welfare requests. Null for a request that isn't about money.
  amountRequestedPesewas Int?
  neededBy               DateTime?

  status SupportRequestStatus @default(SUBMITTED)

  reviewedById String?
  reviewedBy   AdminUser? @relation("SupportRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  approvedAmountPesewas Int?
  /// The recorded spending, once a payout has been made.
  expenseId             String?   @unique
  expense               Expense?  @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  fulfilledAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([memberId])
  @@map("support_requests")
}

/// A study group students run among themselves. Open to any member to join;
/// the student who created it can close it.
model StudyGroup {
  id          String  @id @default(cuid())
  name        String
  /// The course or subject it's for.
  focus       String
  description String?
  /// Where and when they meet, in the students' own words.
  meetingInfo String?

  createdByMemberId String?
  createdBy         Member? @relation("StudyGroupCreator", fields: [createdByMemberId], references: [id], onDelete: SetNull)

  isOpen Boolean @default(true)

  members StudyGroupMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isOpen])
  @@map("study_groups")
}

model StudyGroupMember {
  id       String     @id @default(cuid())
  groupId  String
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  memberId String
  member   Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([groupId, memberId])
  @@index([memberId])
  @@map("study_group_members")
}

// ---------------------------------------------------------------------------
// Alumni Portal: mentorship and the opportunity board
// ---------------------------------------------------------------------------

enum MentorshipStatus {
  REQUESTED
  ACTIVE
  DECLINED
  ENDED
}

/// A student and an alumni mentor, from the student's request through to the
/// end of the pairing. Carries its own conversation and its own sessions, so
/// neither side has to leave the portal or share an email address.
model Mentorship {
  id       String        @id @default(cuid())
  memberId String
  member   Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  alumniId String
  alumni   AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  status      MentorshipStatus @default(REQUESTED)
  /// Why the student asked for this mentor.
  requestNote String?
  /// What they agreed to work on.
  goals       String?

  respondedAt   DateTime?
  declineReason String?
  endedAt       DateTime?

  lastMessageAt   DateTime @default(now())
  unreadByStudent Boolean  @default(false)
  unreadByMentor  Boolean  @default(true)

  sessions MentorshipSession[]
  messages MentorshipMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, alumniId])
  @@index([alumniId, status])
  @@index([memberId, status])
  @@map("mentorships")
}

enum MentorshipSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model MentorshipSession {
  id           String     @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  scheduledFor    DateTime
  topic           String?
  status          MentorshipSessionStatus @default(SCHEDULED)
  note            String?
  /// True when the student booked it, false when the mentor did.
  bookedByStudent Boolean                 @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorshipId, scheduledFor])
  @@map("mentorship_sessions")
}

enum MentorshipSender {
  STUDENT
  MENTOR
}

model MentorshipMessage {
  id           String     @id @default(cuid())
  mentorshipId String
  mentorship   Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)

  sender MentorshipSender
  body   String

  createdAt DateTime @default(now())

  @@index([mentorshipId, createdAt])
  @@map("mentorship_messages")
}

enum OpportunityType {
  JOB
  INTERNSHIP
  SCHOLARSHIP
  VOLUNTEER
}

enum OpportunityStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A job, internship, scholarship or volunteering opening posted by an
/// alumnus for students and fellow graduates. Reviewed by an administrator
/// before it appears, for the same reason broadcasts are: it carries an
/// outside link into the portal.
model Opportunity {
  id           String         @id @default(cuid())
  alumniId     String?
  alumni       AlumniProfile? @relation(fields: [alumniId], references: [id], onDelete: SetNull)
  /// Who posted it, captured when written.
  postedByName String

  title        String
  organization String
  type         OpportunityType
  location     String?
  description  String
  applyUrl     String?
  applyEmail   String?
  closingDate  DateTime?

  status       OpportunityStatus @default(PENDING)
  reviewedById String?
  reviewedBy   AdminUser?        @relation("OpportunityReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([alumniId])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// Allies & Champions
// ---------------------------------------------------------------------------

enum AllyType {
  INDIVIDUAL
  CORPORATE
}

/// A named supporter on the public Allies & Champions page. Always added or
/// approved by an administrator — often from a sign-up that asked to be
/// listed, but never automatically: a name on that page is the association
/// vouching for the connection.
model Ally {
  id   String   @id @default(cuid())
  type AllyType
  name String

  /// A headshot for a person, a logo for an organisation.
  imageUrl       String?
  /// A person's title, e.g. "Senior Policy Advisor".
  role           String?
  /// Where a person works, e.g. "Accessibility Division".
  organization   String?
  /// An organisation's field, e.g. "Higher Education" or "Assistive Tech".
  sector         String?
  /// A person's "why I support" statement, or an organisation's
  /// partnership note ("Sponsoring digital inclusion since 2024").
  statement      String?
  /// A longer quote for the spotlight section. Shown only when featured.
  spotlightQuote String?
  featured       Boolean @default(false)
  websiteUrl     String?

  order    Int     @default(0)
  isActive Boolean @default(true)

  /// The public sign-up this listing came from, where it came from one.
  signupId String?     @unique
  signup   AllySignup? @relation(fields: [signupId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isActive])
  @@map("allies")
}

enum AllySignupStatus {
  NEW
  REVIEWED
  LISTED
}

/// Someone who joined the ally network from the public page, without an
/// account: an email address for updates and advocacy alerts and, if they
/// asked, a request to be listed publicly.
///
/// Nothing is sent to an address until its owner clicks the confirmation
/// link, so nobody can sign somebody else up; every later email carries an
/// unsubscribe link built from the same token.
model AllySignup {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  type         AllyType
  /// "Organisation / Role", in their own words.
  organization String?
  wantsListing Boolean  @default(false)

  status         AllySignupStatus @default(NEW)
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  /// The secret in their confirmation and unsubscribe links.
  token          String           @unique

  ally Ally?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([confirmedAt])
  @@map("ally_signups")
}

// ---------------------------------------------------------------------------
// Assistive software
// ---------------------------------------------------------------------------

enum SoftwareCategory {
  VISION
  HEARING
  COGNITIVE
  MOBILITY
}

/// One tool in the public assistive software directory. The software itself
/// lives in the association's Telegram library; this is the listing that
/// says what it is, who it's for and where to get it.
model AssistiveSoftware {
  id          String           @id @default(cuid())
  name        String
  logoUrl     String?
  category    SoftwareCategory
  /// WINDOWS, MACOS, ANDROID, IOS, LINUX, WEB.
  platforms   String[]         @default([])
  description String
  /// Free or open source, as opposed to a paid licence bought with donations.
  isFree      Boolean          @default(true)
  /// A direct link to this tool's post in the Telegram library. Falls back
  /// to the library itself when not set.
  telegramUrl String?
  websiteUrl  String?

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isActive])
  @@map("assistive_software")
}

/// What someone is asking the technical team for.
enum TechRequestKind {
  SOFTWARE
  TUTORIAL
}

enum SoftwareRequestStatus {
  NEW
  IN_PROGRESS
  FULFILLED
  /// Not possible as asked, but the team offered an alternative or a note
  /// explaining why — distinct from a request simply turned down.
  UNFULFILLABLE
  DECLINED
}

/// A request for a tool the library doesn't have yet, from the public page.
/// Handled by the technical team; paid tools are bought with donations.
/// Where a tutorial lives. Only the two the association actually posts to.
enum TutorialSource {
  YOUTUBE
  TIKTOK
}

/// A video walk-through — using a screen reader, setting up captions,
/// getting the most out of a phone's accessibility settings.
///
/// The video itself stays on YouTube or TikTok, where it is already
/// captioned and playable; this row is what the site needs to show a card
/// for it and let someone play or open it.
model Tutorial {
  id          String         @id @default(cuid())
  title       String
  description String
  source      TutorialSource
  /// The page a viewer would open: a YouTube watch URL or a TikTok video URL.
  url         String
  /// For YouTube, the video id pulled out of the URL — enough to show a
  /// thumbnail and play it in place, without loading anything from
  /// YouTube until someone asks for it.
  videoId     String?
  /// Uploaded by an administrator. YouTube falls back to its own thumbnail.
  thumbnailUrl String?
  /// Which kind of access it helps with, so it filters alongside software.
  category     SoftwareCategory?
  /// As written on the video, e.g. "8 min".
  durationLabel String?

  order    Int     @default(0)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
  @@map("tutorials")
}

model SoftwareRequest {
  id       String          @id @default(cuid())
  kind     TechRequestKind @default(SOFTWARE)
  fullName String
  email    String
  /// The software they need, or what the tutorial should cover. The column
  /// keeps its original name so existing requests are untouched.
  topic           String           @map("softwareName")
  category        SoftwareCategory
  /// Only asked for software: a tutorial is watched, not installed.
  operatingSystem String?
  notes           String?

  /// The signed-in student who asked, when they were signed in.
  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  status      SoftwareRequestStatus @default(NEW)
  adminNote   String?
  /// Where the thing they asked for now lives: a Telegram post, a tutorial
  /// on the site, a download page. Sent to them with the update.
  resourceLink String?
  handledById String?
  handledBy   AdminUser?            @relation("SoftwareRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@map("software_requests")
}

// ---------------------------------------------------------------------------
// Alumni: earlier programmes
// ---------------------------------------------------------------------------

/// An undergraduate programme an alumnus completed before the postgraduate
/// study the association has on record — often before the portal existed,
/// or at another university. Added by the alumnus themselves, so it is shown
/// as their own account of their education, not as an association record.
model AlumniPriorProgramme {
  id       String        @id @default(cuid())
  alumniId String
  alumni   AlumniProfile @relation(fields: [alumniId], references: [id], onDelete: Cascade)

  /// "Bachelor's degree", "Diploma", "Higher National Diploma" or "Other".
  qualification String
  programme     String
  institution   String
  yearCompleted Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alumniId])
  @@map("alumni_prior_programmes")
}
